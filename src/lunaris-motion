#!/usr/bin/env bash
# vim:foldmethod=marker

# Variables {{{

# Settings {{{

LUNARIS_MOTION_PLAYER_CONFIG=""
LUNARIS_MOTION_WORKSHOP_DIR=""
# }}}

# Default {{{

LUNARIS_MOTION_CACHE_FILE="$HOME/.cache/lunaris-motion"
LUNARIS_MOTION_SOCKET="/run/user/$UID/lunaris-motion.sock"
LUNARIS_MOTION_SYSTEM_DIR="/etc/xdg/lunaris-motion"
# }}}

# }}}

# Functions {{{

# Log {{{

log() {
	echo "[$(date +'%Y-%m-%d %H:%M:%S')]: $*" >&2
}
# }}}

# Workshop {{{

workshop() {
	local selected_wallpaper workshop_dir

	# Check for workshop
	if [[ -d "$HOME/.local/share/Steam/steamapps/workshop/content/431960" ]]; then
		workshop_dir="$HOME/.local/share/Steam/steamapps/workshop/content/431960"
	elif [[ -d "$HOME/.var/app/com.valvesoftware.Steam/.local/share/Steam/steamapps/workshop/content/431960" ]]; then
		workshop_dir="$HOME/.var/app/com.valvesoftware.Steam/.local/share/Steam/steamapps/workshop/content/431960"
	elif [[ -d "$LUNARIS_MOTION_WORKSHOP_DIR" ]]; then
		workshop_dir="$LUNARIS_MOTION_WORKSHOP_DIR"
	else
		log "[ERROR]: Workshop installation not found"
		exit 1
	fi

	# Select Wallpaper
	selected_wallpaper="$(rofi -config "$LUNARIS_MOTION_SYSTEM_DIR/lunaris-motion-grid" -show recursivebrowser -normal-window \
		-recursivebrowser-directory "$workshop_dir" -recursivebrowser-filter-regex "(.*\.json|.*\.gif|.*\.jpg|.*\.png)" 2>/dev/null)"

	# Exit if no wallpaper is selected
	if [[ -z "$selected_wallpaper" ]]; then
		log "[ERROR]: No selected wallpaper"
		exit 1
	else
		# Set wallpaper on cache
		printf '%s' "$selected_wallpaper" >"$LUNARIS_MOTION_CACHE_FILE"
	fi
}
# }}}

# Player {{{

player() {
	local player_config wallpaper_file

	# Load wallpaper from cache
	if [[ -f "$LUNARIS_MOTION_CACHE_FILE" ]]; then
		wallpaper_file="$(<"$LUNARIS_MOTION_CACHE_FILE")"
		log "[INFO]: Last video loaded from cache"
	else
		log "[ERROR]: No wallpaper loaded"
		exit 1
	fi

	# Load player configuration
	if [[ -f "$LUNARIS_MOTION_PLAYER_CONFIG/mpv.conf" ]]; then
		player_config="$LUNARIS_MOTION_PLAYER_CONFIG"
		log "[INFO]: User player configuration loaded"
	else
		player_config="$LUNARIS_MOTION_SYSTEM_DIR"
		log "[INFO]: System player configuration loaded"
	fi

	# Embed video
	xwinwrap -ni -fdt -fs -s -st -sp -b -nf -ovr -d -- \
		mpv -wid WID "$wallpaper_file" --config-dir="$player_config" --input-ipc-server="$LUNARIS_MOTION_SOCKET" \
		--fullscreen --panscan=1 --no-audio --loop \
		--input-default-bindings=no --input-cursor=no --osc=no --osd-level=0 --terminal=no 2>/dev/null
}

cleanup() {
	# Kill old instances
	pkill xwinwrap
	pkill -f "$LUNARIS_MOTION_SYSTEM_DIR/lunaris-motion-daemon.sh"
	rm -f "$LUNARIS_MOTION_SOCKET"
	log "[INFO]: Killed old instances"
}
# }}}

# Socket {{{

player_play() {
	if [[ -S "$LUNARIS_MOTION_SOCKET" ]]; then
		printf '%s\n' '{ "command": ["set_property", "pause", false] }' | socat - UNIX-CONNECT:"$LUNARIS_MOTION_SOCKET" >/dev/null
		log "[INFO]: Resume player"
	else
		log "[ERROR]: Socket missing"
	fi
}

player_pause() {
	if [[ -S "$LUNARIS_MOTION_SOCKET" ]]; then
		printf '%s\n' '{ "command": ["set_property", "pause", true] }' | socat - UNIX-CONNECT:"$LUNARIS_MOTION_SOCKET" >/dev/null
		log "[INFO]: Pause player"
	else
		log "[ERROR]: Socket missing"
	fi
}
# }}}

# Slave {{{

daemon() {
	# Start daemon
	nohup "$LUNARIS_MOTION_SYSTEM_DIR/lunaris-motion-daemon.sh" >/dev/null 2>&1 &
}
# }}}

# Help {{{

show_help() {
	cat <<EOF
USAGE:
  <env> $0 <command>

COMMANDS:
  -w|--workshop                					Select video from workshop
  -r|--restore                          Restore cached wallpaper with daemon
  -dls|--daemonless                     Restore cached wallpaper without daemon

  --play                                Resume player
  --pause                               Pause player
  -k|--kill                             Kill running player


  -h|--help                             Display this help message

ENV:
  LUNARIS_MOTION_PLAYER_CONFIG          Custom mpv configuration directory
  LUNARIS_MOTION_WORKSHOP_DIR   				Custom workshop installation directory

EOF
}
# }}}

# }}}

# Master {{{

case "$1" in
-w | --workshop)
	workshop
	cleanup
	player
	daemon
	;;

-r | --restore)
	cleanup
	player
	daemon
	;;

-d | --daemonless)
	cleanup
	player
	log "[INFO]: Start player daemonless"
	;;

--play)
	player_play
	;;

--pause)
	player_pause
	;;

-k | --kill)
	cleanup
	;;

-h | --help)
	show_help
	exit 0
	;;

*)
	log "[ERROR]: Option not found, use -h or --help for help"
	exit 1
	;;
esac
# }}}
